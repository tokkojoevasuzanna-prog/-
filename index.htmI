!DOCTYPE html>
<html lang="ky">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f5e5d4"><title>Бекжан & Алия — Тойго чакыруу</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Great+Vibes&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--cream:#fff8ef;--champ:#f2dfc9;--gold:#a56b25;--dark:#684018;--ink:#684a30}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f8eee4;color:var(--ink);font-family:Manrope,Arial,sans-serif}button{font:inherit}.cover{min-height:100svh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 50% 35%,#fffaf4,#e8cdb2);position:relative;overflow:hidden}.cover:before,.cover:after{content:'✿';position:absolute;color:#c18a4c66;font-size:110px}.cover:before{top:3%;left:2%}.cover:after{bottom:3%;right:2%}.envelope-wrap{width:min(92vw,560px);position:relative;cursor:pointer;filter:drop-shadow(0 18px 28px #7a4d292b);transition:transform .35s}.envelope-wrap:hover{transform:translateY(-5px)}.envelope-wrap img{width:100%;display:block;border-radius:5px}.open-label{position:absolute;bottom:8%;left:50%;transform:translateX(-50%);white-space:nowrap;border:1px solid #a56b25;background:#fff8efed;color:#81501c;padding:13px 24px;border-radius:30px;letter-spacing:1.5px;font-size:11px;font-weight:600;box-shadow:0 5px 20px #6c451c22}.hint{position:absolute;bottom:22px;font-size:11px;letter-spacing:2px;color:#8c6846}.invitation{display:none;animation:reveal .9s ease both}.invitation.visible{display:block}@keyframes reveal{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}.section{max-width:850px;margin:0 auto;padding:76px 22px;text-align:center}.eyebrow{font-family:'Cormorant Garamond',serif;text-transform:uppercase;letter-spacing:4px;font-size:13px;color:#a77942}.script{font-family:'Great Vibes',cursive;color:#9a5f20;font-weight:400}.hero{padding-top:80px}.hero h1{font:clamp(58px,12vw,100px)/.95 'Great Vibes',cursive;margin:18px 0 8px;color:#95591d}.hero .amp{font-family:'Cormorant Garamond',serif;font-size:.6em}.heart{color:#b47b37;font-size:26px;margin:14px}.intro{font:italic clamp(20px,4vw,27px)/1.5 'Cormorant Garamond',serif;max-width:650px;margin:22px auto}.photo{width:100%;max-height:620px;object-fit:cover;display:block;border-radius:4px;box-shadow:0 18px 40px #78532b22}.photo-frame{padding:10px;border:1px solid #c99c64;max-width:650px;margin:28px auto;background:#fff9f1}.date-card{display:flex;justify-content:center;gap:24px;flex-wrap:wrap;margin:30px auto;padding:20px 26px;border:1px solid #b88343;border-radius:60px;max-width:560px;font:26px 'Cormorant Garamond',serif}.date-card span{display:flex;align-items:center;gap:10px}.date-card b{font-size:13px;letter-spacing:2px;font-family:Manrope,sans-serif;font-weight:500}.divider{display:flex;align-items:center;gap:16px;justify-content:center;color:#b17b3d;margin:28px 0}.divider:before,.divider:after{content:'';height:1px;width:90px;background:#c99a60}.divider span{font-size:22px}.names-image{max-width:480px;width:100%;margin:24px auto;display:block}.details{background:linear-gradient(145deg,#fffaf4,#f0ddc8);border-top:1px solid #d8b98f;border-bottom:1px solid #d8b98f}.details h2,.rsvp h2{font:clamp(36px,7vw,56px) 'Great Vibes',cursive;color:#965d22;margin:12px}.detail-line{font:24px 'Cormorant Garamond',serif;margin:14px}.countdown{display:flex;justify-content:center;gap:12px;margin:26px auto}.countdown div{min-width:68px;padding:13px 8px;background:#fffaf4;border:1px solid #d6b17d;border-radius:8px}.countdown strong{display:block;font:28px 'Cormorant Garamond',serif;color:#8a551f}.countdown small{font-size:9px;letter-spacing:1px}.location-card{margin:24px auto;padding:25px;border:1px solid #c99a60;background:#fffaf4;max-width:540px}.location-card h3{font:34px 'Great Vibes',cursive;color:#965d22;margin:8px}.rsvp{background:#fffaf4}.choice{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:25px 0}.choice button,.music-btn{border:1px solid #a87335;background:transparent;color:#80501f;padding:13px 20px;border-radius:30px;cursor:pointer}.choice button.selected,.choice button:hover,.music-btn:hover{background:#a87335;color:white}.guest-name{width:min(100%,360px);padding:14px;border:1px solid #d2b184;background:white;border-radius:5px;font:15px Manrope;margin:10px}.send{display:inline-block;border:0;background:#9b642b;color:white;padding:14px 30px;border-radius:30px;cursor:pointer;margin:12px}.note{font:italic 23px 'Cormorant Garamond',serif}.footer{padding:38px 20px;text-align:center;background:#efddca;color:#906331;font:30px 'Great Vibes',cursive}.music-control{position:fixed;right:16px;bottom:16px;z-index:5;background:#fffaf0ed;border:1px solid #b8874b;border-radius:30px;padding:10px 15px;color:#80501f;display:none;cursor:pointer;box-shadow:0 5px 18px #68401822}.music-control.show{display:block}.status{min-height:24px;color:#8a5b2a;font-size:13px}@media(max-width:520px){.section{padding:55px 18px}.date-card{gap:12px;padding:16px}.date-card span{font-size:22px}.countdown{gap:6px}.countdown div{min-width:58px}.open-label{font-size:10px;padding:11px 15px}}
</style></head>
<body>
<section class="cover" id="cover" aria-label="Чакыруу конверти">
 <div class="envelope-wrap" id="openInvite" role="button" tabindex="0" aria-label="Конвертти ачуу">
  <img src="assets/envelope.png" alt="Алтын бантиги жана шакек мөөрү бар той чакыруу конверти">
  <div class="open-label">♡ ЧАКЫРУУНУ АЧУУ ♡</div>
 </div><div class="hint">СҮЙҮҮ МЕНЕН ДАЯРДАЛДЫ</div>
</section>
<main class="invitation" id="invitation">
 <section class="section hero"><div class="eyebrow">Сиздерди терең урматтоо менен</div><div class="heart">♡</div><p class="intro">Жашообуздагы эң бактылуу жана өзгөчө күндөрдүн биринде сиздерди кубанычыбызга ортоктош болууга чакырабыз!</p><h1>Бекжан <span class="amp">&</span> Алия</h1><div class="divider"><span>♡</span></div><p class="eyebrow">Үйлөнүү тоюбузга чакырабыз</p>
 <div class="photo-frame"><img class="photo" src="assets/couple.png" alt="Келин менен күйөө баланын сүрөтү"></div>
 </section>
 <section class="section details"><div class="eyebrow">Бактылуу күн</div><h2>Той салтанаты</h2><div class="divider"><span>♡</span></div><div class="date-card"><span>♧ <b>28-ОКТЯБРЬ, 2026</b></span><span>◷ <b>16:00</b></span></div><div class="countdown" id="countdown"><div><strong>--</strong><small>КҮН</small></div><div><strong>--</strong><small>СААТ</small></div><div><strong>--</strong><small>МҮНӨТ</small></div><div><strong>--</strong><small>СЕКУНД</small></div></div><p class="note">Сиздердин катышууңуздар биз үчүн чоң мааниге ээ!</p></section>
 <section class="section"><div class="photo-frame"><img class="photo" src="assets/hands.png" alt="Жаш жубайлардын кол кармашкан сүрөтү"></div><div class="divider"><span>♡</span></div><p class="eyebrow">Той өтүүчү жай</p><h2 class="script" style="font-size:58px;margin:8px">Асман</h2><p class="detail-line">Ресторан «Асман»</p><p class="note">Сиздерди күтөбүз!</p></section>
 <section class="section rsvp"><div class="divider"><span>♡</span></div><h2>Катышууңузду ырастаңыз</h2><p class="intro">Тойго келериңизди билдирип коюңуз.</p><input class="guest-name" id="guestName" placeholder="Атыңызды жазыңыз" aria-label="Атыңыз"><div class="choice"><button type="button" data-choice="Ооба, барам">Ооба, барам</button><button type="button" data-choice="Тилекке каршы, бара албайм">Шартым туура келбейт</button></div><button class="send" id="sendRsvp">Жоопту даярдоо</button><div class="status" id="status" aria-live="polite"></div><p class="note">Той ээлери — Алмаз & Азиза</p><p class="intro">Тойго келип, кадырлуу коногубуз болуп кетиңиздер!</p></section>
 <footer class="footer">Бекжан & Алия · 28.10.2026</footer>
</main>
<audio id="music" src="assets/music.mp3" preload="auto" loop></audio><button class="music-control" id="musicControl" type="button">♫ Музыканы токтотуу</button>
<script>
const cover=document.getElementById('cover'), invitation=document.getElementById('invitation'), music=document.getElementById('music'), musicControl=document.getElementById('musicControl');
function openInvite(){cover.style.display='none';invitation.classList.add('visible');musicControl.classList.add('show');music.play().then(()=>{musicControl.textContent='♫ Музыканы токтотуу'}).catch(()=>{musicControl.textContent='♫ Музыканы күйгүзүү'});invitation.scrollIntoView({behavior:'smooth'});}
document.getElementById('openInvite').addEventListener('click',openInvite);document.getElementById('openInvite').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openInvite();}});
musicControl.addEventListener('click',()=>{if(music.paused){music.play().then(()=>musicControl.textContent='♫ Музыканы токтотуу').catch(()=>{});}else{music.pause();musicControl.textContent='♫ Музыканы күйгүзүү';}});
const target=new Date('2026-10-28T16:00:00+06:00');function tick(){let ms=target-new Date();const boxes=document.querySelectorAll('#countdown strong');if(ms<=0){document.getElementById('countdown').innerHTML='<p class="note">Бул өзгөчө күн келди! ♡</p>';return;}let vals=[Math.floor(ms/86400000),Math.floor(ms/3600000)%24,Math.floor(ms/60000)%60,Math.floor(ms/1000)%60];boxes.forEach((b,i)=>b.textContent=String(vals[i]).padStart(2,'0'));}tick();setInterval(tick,1000);
let selected='';document.querySelectorAll('[data-choice]').forEach(btn=>btn.addEventListener('click',()=>{selected=btn.dataset.choice;document.querySelectorAll('[data-choice]').forEach(b=>b.classList.toggle('selected',b===btn));}));
document.getElementById('sendRsvp').addEventListener('click',async()=>{const name=document.getElementById('guestName').value.trim();if(!name||!selected){document.getElementById('status').textContent='Атыңызды жазып, жооптун бирин тандаңыз.';return;}const msg=`Бекжан & Алиянын тою\nКонок: ${name}\nЖооп: ${selected}`;try{await navigator.clipboard.writeText(msg);document.getElementById('status').textContent='Жообуңуз даярдалды жана көчүрүлдү. Аны той ээлерине жөнөтүңүз.';}catch(e){document.getElementById('status').textContent=msg+' — бул билдирүүнү көчүрүп, жөнөтүңүз.';}});
</script></body></html>
